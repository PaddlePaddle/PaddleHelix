{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "HelixFold 3.x Open Source Input Schema",
    "description": "Schema for validating HelixFold 3.x Open Source input JSON",
    "type": "object",
    "required": ["entities"],
    "properties": {
      "entities": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": ["type", "count"],
          "properties": {
            "type": {
              "type": "string",
              "enum": ["protein", "dna", "rna", "ion", "ligand"]
            },
            "sequence": {
              "type": "string"
            },
            "smiles": {
              "type": "string"
            },
            "ccd": {
              "type": "string"
            },
            "count": {
              "type": "integer"
            },
            "modification": {
              "type": "array",
              "items": {
                "type": "object",
                "oneOf": [
                  {
                    "required": ["type", "index", "ccd"],
                    "properties": {
                      "type": {
                        "type": "string",
                        "enum": ["residue_replace"]
                      },
                      "index": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "ccd": {
                        "type": "string"
                      }
                    }
                  }
                ]
              }
            }
          },
          "allOf": [
            {
              "if": {
                "properties": { "type": { "enum": ["protein", "dna", "rna"] } }
              },
              "then": {
                "required": ["sequence"]
              }
            },
            {
              "if": {
                "properties": { "type": { "const": "ion" } }
              },
              "then": {
                "required": ["ccd"]
              }
            },
            {
              "if": {
                "properties": { "type": { "const": "ligand" } }
              },
              "then": {
                "anyOf": [
                  { "required": ["smiles"] },
                  { "required": ["ccd"] }
                ]
              }
            }
          ]
        }
      }
    }
  }